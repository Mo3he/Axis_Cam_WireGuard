{
  "schemaVersion": "2.0.0",
  "acapPackageConf": {
    "setup": {
      "friendlyName": "WireGuard VPN",
      "appName": "wireguardconfig",
      "vendor": "moshe@mohome.net",
      "vendorId": "70ee172dd9",
      "compatibleOsVersions": [
        {
          "max": "13"
        }
      ],
      "vendorUrl": "https://github.com/Mo3he/Axis_Cam_WireGuard",
      "runMode": "respawn",
      "version": "1.2.15",
      "user": {
        "group": "sdk",
        "username": "sdk"
      },
      "architecture": "BUILDARCH"
    },
    "configuration": {
      "settingPage": "index.html",
      "reverseProxy": [
        {
          "apiPath": "api",
          "target": "http://localhost:2203/",
          "access": "admin"
        }
      ],
      "paramConfig": [
        {
          "name": "PrivateKey",
          "default": "",
          "type": "string"
        },
        {
          "name": "ListenPort",
          "default": "51820",
          "type": "string"
        },
        {
          "name": "Endpoint",
          "default": "",
          "type": "string"
        },
        {
          "name": "PeerPublicKey",
          "default": "",
          "type": "string"
        },
        {
          "name": "AllowedIPs",
          "default": "0.0.0.0/0",
          "type": "string"
        },
        {
          "name": "ClientIP",
          "default": "10.0.0.2/24",
          "type": "string"
        },
        {
          "name": "HTTPProxyPort",
          "default": "8080",
          "type": "string"
        },
        {
          "name": "OutboundSOCKS5Port",
          "default": "1080",
          "type": "string"
        },
        {
          "name": "ForwardPorts",
          "default": "80,443,554",
          "type": "string"
        }
      ]
    }
  }
}
