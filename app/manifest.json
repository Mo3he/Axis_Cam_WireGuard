{
    "schemaVersion": "1.7.0",
    "acapPackageConf": {
        "setup": {
            "friendlyName": "WireGuard VPN",
            "appName": "wireguardconfig",
            "vendor": "Mo3he",
            "embeddedSdkVersion": "3.0",
            "vendorUrl": "https://github.com/Mo3he/Axis_Cam_WireGuard",
            "runMode": "respawn",
            "version": "1.2.1",
            "user": {
                "group": "sdk",
                "username": "sdk"
            },
            "architecture": "BUILDARCH"
        },
        "configuration": {
            "settingPage": "index.html",
            "paramConfig": [
                {"name": "PrivateKey",    "default": "",            "type": "string"},
                {"name": "ListenPort",    "default": "51820",       "type": "string"},
                {"name": "Endpoint",      "default": "",            "type": "string"},
                {"name": "PeerPublicKey", "default": "",            "type": "string"},
                {"name": "AllowedIPs",    "default": "0.0.0.0/0",  "type": "string"},
                {"name": "ClientIP",      "default": "10.0.0.2/24","type": "string"}
            ]
        }
    }
}
