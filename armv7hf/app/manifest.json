{
    "schemaVersion": "1.7.3",
    "acapPackageConf": {
        "setup": {
            "friendlyName": "WireGuard VPN",
            "appName": "wireguardconfig",
            "vendor": "WireGuard - Packaged by Mo3he",
            "embeddedSdkVersion": "3.0",
            "vendorUrl": "https://www.wireguard.com",
            "runMode": "respawn",
            "version": "1.1.0",
            "user": {
                "group": "sdk",
                "username": "sdk"
            },
            "architecture": "armv7hf"
        },
        "configuration": {
            "paramConfig": [
                {
                    "name": "PrivateKey",
                    "default": "",
                    "type": "password"
                },
                {
                    "name": "ListenPort",
                    "default": "51820",
                    "type": "string"
                },
                {
                    "name": "Endpoint",
                    "default": "",
                    "type": "string"
                },
                {
                    "name": "PeerPublicKey",
                    "default": "",
                    "type": "string"
                },
                {
                    "name": "AllowedNetworks",
                    "default": "0.0.0.0/0",
                    "type": "string"
                },
                {
                    "name": "ClientIP",
                    "default": "10.0.0.2/24",
                    "type": "string"
                }
            ]
        }
    }
}
