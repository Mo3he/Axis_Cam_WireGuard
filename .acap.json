    "changesUrl": "https://git.zx2c4.com/wireguard-go/log/"
  },
  "build": {
    "command": "./build.sh && (cd acap3 && ./build.sh)",
    "env": {}
  },
  "pins": [],
  "signing": {
    "skip": [
      "*_acap3.eap",
      "*_root.eap"
    ]
  }
}
